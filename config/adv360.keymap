#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        #endif

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        htlayer: htlayer {
            compatible = "zmk,behavior-hold-tap";
            label = "HTLAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp F2     &kp N1                &kp N2                 &kp N3      &kp N4              &kp N5        &tog 4                                                                  &mo 5      &kp N6        &kp N7        &kp N8      &kp N9               &kp N0           &kp F12
&kp TAB    &kp Q                 &kp W                  &kp E       &kp R               &kp T         &kp EQUAL                                                               &kp MINUS  &kp Y         &kp U         &kp I       &kp O                &kp P            &kp BSLH
&kp ESC    &hm LSHIFT A          &hm LEFT_CONTROL S     &hm LALT D  &hm LEFT_COMMAND F  &htlayer 1 G  &kp EQUAL  &lt 3 GRAVE     &kp LA(GRAVE)      &kp F2         &kp F12    &kp MINUS  &htlayer 1 H  &hm RCMD J    &hm RALT K  &hm RIGHT_CONTROL L  &hm RSHIFT SEMI  &kp SQT
&kp EQUAL  &kp Z                 &kp X                  &kp C       &lt 3 V             &kp B                                    &kp ESC            &kp PAGE_UP                          &kp N         &kp M         &kp COMMA   &kp DOT              &kp FSLH         &kp MINUS
&mo 1      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT    &kp RIGHT                         &kp BSPC   &kp LEFT_SHIFT  &lt 2 TAB          &kp PAGE_DOWN  &kp ENTER  &kp SPACE                &kp UP_ARROW  &kp DOWN    &kp LBKT             &kp RBKT         &kp EQUAL
            >;
        };

        fn {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                                       &mo 2            &kp F7         &kp F8    &kp F9    &kp F10    &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                       &trans           &kp PAGE_UP    &kp HOME  &kp UP    &kp END    &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans        &kp C_MUTE         &trans           &kp PAGE_DOWN  &kp LEFT  &kp DOWN  &kp RIGHT  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &kp UP_ARROW                                      &trans         &trans    &trans    &trans     &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &kp DOWN      &kp C_VOLUME_DOWN  &kp C_VOLUME_UP                 &trans    &trans    &trans     &trans   &trans
            >;
        };

        symbols {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                                       &mo 2            &kp F7          &kp F8                &kp F9                 &kp F10      &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                       &trans           &kp UNDERSCORE  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp AT_SIGN  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans        &kp C_MUTE         &trans           &kp MINUS       &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp HASH     &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &kp UP_ARROW                                      &kp EQUAL       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PERCENT  &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &kp DOWN      &kp C_VOLUME_DOWN  &kp C_VOLUME_UP                  &kp LESS_THAN         &kp GREATER_THAN       &trans       &trans   &trans
            >;
        };

        numbers {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 2   &kp F7          &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &kp UNDERSCORE  &kp N7  &kp N8  &kp N9   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp MINUS       &kp N4  &kp N5  &kp N6   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &kp EQUAL       &kp N1  &kp N2  &kp N3   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans                  &kp N0  &kp N0  &kp DOT  &trans   &trans
            >;
        };

        keypad {
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 2      &kp N6  &kp KP_NUM       &kp KP_EQUAL     &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7        &kp KP_N8        &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4        &kp KP_N5        &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1        &kp KP_N2        &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp KP_NUMBER_0  &kp KP_NUMBER_0  &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans                  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &bootloader                                            &bootloader             &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &macro_ver    &none                             &none      &none                                           &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
